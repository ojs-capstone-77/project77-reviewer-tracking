parameters:
    level: 5
    paths:
        - groupReview
    excludePaths:
        analyseAndScan:
            - */groupReview/tests/*
        analyse:
            - */groupReview/vendor/*
    scanDirectories:
        - ojs-src
    stubFiles:
        - phpstan-stubs/Mailable.stub.php
        - phpstan-stubs/ReviewRoundDAO.stub.php
